{
  "model": "Qwen/Qwen2.5-1.5B-Instruct",
  "dataset": "abisee/cnn_dailymail",
  "dataset_config": "3.0.0",
  "seed": 42,
  "split_sizes": {"train": 10000, "validation": 500, "test": 500},
  "max_prompt_tokens": 1536,
  "max_target_tokens": 256,
  "max_length": 2048,
  "system_prompt": "You summarize news articles accurately. Use only information from the article.",
  "user_template": "Write a concise summary of the following news article. Return only the summary.\n\n{article}",
  "training": {
    "num_train_epochs": 2,
    "per_device_train_batch_size": 2,
    "per_device_eval_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.00002,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.05,
    "weight_decay": 0.01,
    "optim": "adamw_torch",
    "bf16": true,
    "tf32": true,
    "gradient_checkpointing": true,
    "gradient_checkpointing_kwargs": {"use_reentrant": false},
    "logging_steps": 25,
    "eval_strategy": "epoch",
    "save_strategy": "epoch",
    "save_total_limit": 1,
    "save_only_model": true,
    "load_best_model_at_end": true,
    "metric_for_best_model": "eval_loss",
    "greater_is_better": false,
    "prediction_loss_only": true,
    "report_to": "none",
    "dataloader_num_workers": 2
  },
  "generation": {"do_sample": false, "max_new_tokens": 256, "num_beams": 1},
  "lora_defaults": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "v_proj"],
    "bias": "none",
    "task_type": "CAUSAL_LM",
    "use_rslora": false
  },
  "experiments": {
    "base": {"method": "base"},
    "full_ft": {"method": "full"},
    "lora_baseline": {"method": "lora"},
    "lora_r8": {"method": "lora", "overrides": {"r": 8}},
    "lora_r32": {"method": "lora", "overrides": {"r": 32}},
    "lora_alpha16": {"method": "lora", "overrides": {"lora_alpha": 16}},
    "lora_alpha64": {"method": "lora", "overrides": {"lora_alpha": 64}},
    "lora_dropout0": {"method": "lora", "overrides": {"lora_dropout": 0.0}},
    "lora_dropout01": {"method": "lora", "overrides": {"lora_dropout": 0.1}},
    "lora_attention": {"method": "lora", "overrides": {"target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"]}},
    "lora_attention_mlp": {"method": "lora", "overrides": {"target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]}}
  }
}
